# 이 파일을 복사해 .env 로 저장하고 실제 값을 입력하세요: cp .env.example .env
# .env 는 시크릿을 포함하므로 git에 커밋하지 마세요 (.gitignore 등록됨).

# PostgreSQL 접속 정보 (docker-compose postgres 서비스와 공유)
DATABASE_URL=
# 예: postgresql+psycopg://ai_studio:ai_studio_pw@postgres:5432/ai_studio
# DATABASE_URL의 user/pass/db는 아래 POSTGRES_* 와 일치해야 한다.

# docker-compose postgres 컨테이너의 초기 계정/DB (위 DATABASE_URL과 일치시킬 것)
POSTGRES_USER=
# 예: ai_studio
POSTGRES_PASSWORD=
# 예: ai_studio_pw
POSTGRES_DB=
# 예: ai_studio

# Redis 접속 정보 (SSE 백엔드, Celery 브로커/백엔드)
REDIS_URL=
# 예: redis://redis:6379/0

# 프로젝트/라이브러리 산출물이 저장되는 루트 디렉토리
PROJECTS_ROOT=
# 예 (직접 실행 시 호스트 절대경로): /data/ai-studio
# docker compose 사용 시: /data/ai-studio (compose가 ./projects를 마운트함)

# API 리스닝 포트
API_PORT=

# SSE 백엔드: redis 또는 memory (단일 프로세스 개발 시 memory)
SSE_BACKEND=
# 허용값: redis | memory

# 로그 레벨
LOG_LEVEL=
# 예: info

# ComfyUI 연동 (http_polling 어댑터 seed: infra/seeds/models/comfyui.json)
# submit 엔드포인트 전체 URL을 기입 (경로 /prompt 포함).
# base_url(http://host:port)은 어댑터가 여기서 자동 추출해
# /history, /view, /upload/image 호출에 사용한다.
# → ComfyUI 머신을 옮길 때는 이 한 줄만 바꾸면 된다.
# 예: COMFYUI_URL=http://127.0.0.1:8188/prompt
# Docker 컨테이너에서 호스트의 ComfyUI에 붙을 때는
# COMFYUI_URL=http://host.docker.internal:8188/prompt
# (Linux Docker면 compose에 extra_hosts: ["host.docker.internal:host-gateway"] 필요).
# 원격 머신의 ComfyUI는 직접 노출하지 말고 토큰 프록시(Caddy 등) 뒤에 두고
# seed의 headers에 {"Authorization": "env:COMFYUI_TOKEN"} 형태로 전달한다.
# 자세한 내용은 docs/PROVIDERS.md.
COMFYUI_URL=

# --- HTTP 폴링 제공자 키 (models_lib http_polling 어댑터) ---
# 모델 seed JSON의 capabilities.http 블록은 시크릿을 "env:VAR_NAME" 형태로만
# 참조한다. 실제 값은 seed/코드에 절대 넣지 말고 여기(.env)에만 둔다.
# fal.ai queue API (https://fal.ai)
FAL_API_KEY=
# 예: <fal key>
# Replicate (https://replicate.com)
REPLICATE_API_TOKEN=
# 예: r8_...
# Higgsfield API (https://console.higgsfield.ai) — Seedance 2.5 파일럿용
# 콘솔 Settings → API Keys에서 발급하는 Key ID + Secret 쌍을
# "Key <id>:<secret>" 형태로 한 줄로 합쳐 기입한다.
# (seed의 Authorization 헤더가 이 값 전체를 그대로 보낸다)
HF_API_KEY=
# 예: Key 9f3a...:7b2c...

# ffmpeg 바이너리 경로 (Phase 3). 비워 두면 PATH에서 ffmpeg 탐색
FFMPEG_BIN=
# 예: /usr/bin/ffmpeg

# --- QC vision 스코어러 (Unit C, P2 advisory) ---
# 제네릭 OpenAI-호환 chat completions 엔드포인트라면 무엇이든 연결 가능
# (OpenAI, Ollama /v1, vLLM, LM Studio, ...). 특정 벤더 종속 없음.
# BASE_URL과 MODEL이 둘 다 설정되어야 활성화. 비워 두면 내용 검수 2종은
# stub(warn)으로 동작하며 렌더 게이트에 영향 없음.
QC_VISION_BASE_URL=
# 예 (로컬 Ollama): QC_VISION_BASE_URL=http://127.0.0.1:11434/v1
# Docker 컨테이너에서 호스트의 Ollama에 붙을 때는
# QC_VISION_BASE_URL=http://host.docker.internal:11434/v1
# (Linux Docker면 compose에 extra_hosts: ["host.docker.internal:host-gateway"] 필요).
# 예 (클라우드): QC_VISION_BASE_URL=https://api.openai.com/v1
QC_VISION_API_KEY=
# 예 (로컬 Ollama): 비워 두기 (키 불필요)
# 예 (클라우드): <openai key>
QC_VISION_MODEL=
# 예 (로컬 Ollama): QC_VISION_MODEL=qwen2.5vl:7b  (모델명은 예시 — 강제 아님.
# vision을 지원하는 아무 모델이나 사용 가능. ollama pull 로 미리 받아 둘 것)
# 예 (클라우드): QC_VISION_MODEL=gpt-4o-mini
QC_VISION_TIMEOUT_SEC=
# 예: 60 (비워 두면 60초)
